policy production {
  refinement "raw_material_to_processed_material_to_finished_item";
  fuel_and_water "explicit_inputs_and_accounted_waste_not_free_multipliers";
  counted_products "require_per_item_material_bill_before_activation";
  food "requires_mass_water_cooking_and_energy_model_before_activation";
  medicine "dose_identity_and_authorization_not_generic_craft";
  imports "explicit_finite_arrivals_with_supplier_and_account_ledger";
  scale "batch_quantities_and_shared_supply_chains_not_resource_per_occupation";
}

