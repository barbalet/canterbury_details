recipe mill_wheat {
  input_resources ["wheat_grain"];
  input_quantities [1000];
  output_resources ["flour", "bran"];
  output_quantities [750, 250];
  unit "g";
  accounting "mass_conserved_including_byproducts";
  worker_minutes 30;
  required_equipment ["hand_tool"];
  activation "manual_power_technical_trial";
  basis "illustrative_manual_batch_yield_and_labour_not_period_measurement";
}

recipe cut_timber {
  input_resources ["timber"];
  input_quantities [1000];
