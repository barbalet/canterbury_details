# CANTERBURY_SIM DSL 0.1 — DESIGN DRAFT, NOT EXECUTABLE BY THE CURRENT HOST.
# All quantities, career structures and distributions below are explicit model proposals.
# Unknown staffing, qualifications, routes and authoring rates must fail closed.

scenario canterbury_1940 {
  language_version "0.1";
  profile "CANTERBURY_SIM";
  status "design_draft";
  runtime_activation false;
  civil_origin "1940-01-01T00:00";
  population 27000;
  population_capacity 30000;
  seed 1940;
  clock "native_minute";
  source_map "CanterburyCity.bin";
  unknown_building_uses "provisional_simulation_overlay";
  map_identity "must_match_compiled_content";
  historical_workforce_claim false;
  ownership "single_native_population_positions_energy_and_clock";
  source_career_catalogue_sha256 "d88c883bc066cbad33b546d5e0f60f8c44f1edecbf2443363c3ee4f03e919aa9";
}

limits authoring {
  file_bytes 8388608;
  families 128;
  roles 512;
  resource_kinds 128;
  services 128;
  recipes 512;
  tasks_per_role 256;
  rules_per_role 256;
  expanded_task_statements 4096;
  nesting_depth 64;
  policy "proposed_authoring_budgets_not_current_runtime_limits";
}

policy population {
  cohort_allocation "explicit_synthetic_scenario";
  default_employment false;
  preserve_households_and_guardians true;
  minimum_training_age 16;
  minor_hazard_policy "explicit_safe_duties_supervision_and_guardian_constraints";
  elderly_policy "age_is_not_automatic_incapacity";
  home_and_work_capacity "separate_explicit_estimates";
  housing_shortage "report_unallocated_never_overfill";
  unreachable_workplace "leave_job_unassigned";
  faith_and_title "never_inferred_from_premises_or_tier";
  currency_unit "pence_integer";
  fractional_stock_unit "integer_grams_or_millilitres";
  ownership_transfer "explicit_agreement_and_accounted_payment";
}

cohort age_group_1 {
  age_band "0-4";
  people 2160;
  default_activity "dependent care";
  status "proposed_not_applied";
}

cohort age_group_2 {
  age_band "5-14";
  people 4050;
  default_activity "school";
  status "proposed_not_applied";
}

cohort age_group_3 {
  age_band "15-17";
  people 1620;
  default_activity "education; optional configured apprenticeships from age 16";
  status "proposed_not_applied";
}

cohort age_group_4 {
  age_band "18-64";
  people 16470;
  default_activity "12000 proposed employed; 4470 household care, study, unavailable or seeking work";
  status "proposed_not_applied";
}

cohort age_group_5 {
  age_band "65+";
  people 2700;
  default_activity "retirement and community life; no automatic incapacity assumption";
  status "proposed_not_applied";
}

workforce sector_1 {
