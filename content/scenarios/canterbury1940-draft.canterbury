policy execution {
  priority ["urgent_care", "survival", "travel", "committed_work", "training", "optional_activity"];
  parallel_work_and_travel false;
  read_or_preview_advances_time false;
  event_codes ["EVENT_EAT", "EVENT_CHAT", "EVENT_PROFESSION_WORK", "native_training_and_service_events"];
  checkpoint "versioned_city_native_state_content_and_dsl_identity";
  randomness "named_deterministic_streams_no_wall_clock";
  unknown_reference "compile_error";
  unimplemented_handler "activation_error";
  unqualified_route "explicit_wait_or_assignment_failure";
  validation "draft_linter_is_not_runtime_compilation";
}


recipe trial_portion_meat {
  input_resources ["raw_meat"];
  input_quantities [1000];
  output_resources ["meat_portion", "food_scraps"];
  output_quantities [900, 100];
  unit "g";
  accounting "mass_conserved_including_byproducts";
  worker_minutes 12;
  required_equipment ["hand_tool"];
  activation "manual_power_technical_trial";
  basis "illustrative_manual_batch_yield_and_labour_not_period_measurement";
}

recipe trial_portion_fish {
  input_resources ["raw_fish"];
  input_quantities [1000];
  output_resources ["fish_portion", "food_scraps"];
  output_quantities [850, 150];
  unit "g";
  accounting "mass_conserved_including_byproducts";
  worker_minutes 12;
  required_equipment ["hand_tool"];
  activation "manual_power_technical_trial";
  basis "illustrative_manual_batch_yield_and_labour_not_period_measurement";
}

recipe trial_trim_leather {
  input_resources ["leather"];
  input_quantities [1000];
  output_resources ["leather", "textile_offcuts"];
  output_quantities [850, 150];
  unit "g";
  accounting "mass_conserved_including_byproducts";
  worker_minutes 10;
  required_equipment ["hand_tool"];
  activation "manual_power_technical_trial";
  basis "illustrative_manual_batch_yield_and_labour_not_period_measurement";
}

recipe bake_bread {
  input_resources ["flour", "potable_water", "firewood"];
  input_quantities [750, 300, 120];
  output_resources ["bread", "waste_water", "ash"];
  output_quantities [1000, 50, 12];
  unit "g";
  accounting "water_mass_conserved";
  worker_minutes 25;
  required_equipment ["cooking_equipment"];
  activation "manual_power_technical_trial";
  basis "illustrative_technical_bill_of_materials_labour_and_yield";
